# Production/local PostgreSQL.
# Connection string format:
#   postgresql://[user[:password]@][host][:port]/database
# Omit user/password to use the current OS user with local trust/peer auth.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://localhost:5432/confluo

# Local-only alternative (no PostgreSQL server required):
# DATABASE_DRIVER=pglite
# PGLITE_DATA_DIR=.pglite

# HTTP API port.
PORT=4000

# Hocuspocus WebSocket port. The browser connects to:
#   ws://localhost:4001
HOCUSPOCUS_PORT=4001

# Browser origin allowed to call the HTTP API and open WebSocket connections.
CORS_ORIGIN=http://localhost:5173

# Session cookies are always HttpOnly and SameSite=Lax. They are marked Secure
# automatically when NODE_ENV=production. Override only for local HTTPS setups.
# COOKIE_SECURE=false

# Hocuspocus waits this long after the last change before checkpointing, but
# never longer than the max debounce.
HOCUSPOCUS_DEBOUNCE_MS=2000
HOCUSPOCUS_MAX_DEBOUNCE_MS=10000

# Prune update-log rows only after the covering snapshot and watermark commit
# atomically. Set to false to retain the full log for diagnostics.
PRUNE_UPDATE_LOG=true
